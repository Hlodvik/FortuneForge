{
  "hosting": {
    "public": "fortuneforge.client/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "fortuneforge-api",
          "region": "us-east4"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/slots{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/home{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/admin{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/create-account",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/login",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/verify-email",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
