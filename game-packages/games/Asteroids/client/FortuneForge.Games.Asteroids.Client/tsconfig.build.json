{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/index.ts", "src/AsteroidsGame.tsx", "src/AsteroidsReplayPlay.tsx", "src/contracts.ts", "src/httpAsteroidsGateway.ts", "src/asteroidsHelpers.ts", "src/asteroidsCanvasRenderer.ts", "src/asteroidsReplaySession.ts", "src/asteroidsSimulation.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/dev"]
}
