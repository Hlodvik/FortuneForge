{
  "name": "@fortuneforge/games-cosmic-fortune",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": ["dist", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./manifest": { "types": "./dist/manifest.d.ts", "import": "./dist/manifest.js" },
    "./catalog": { "types": "./dist/catalog.d.ts", "import": "./dist/catalog.js" },
    "./sounds": { "types": "./dist/sounds.d.ts", "import": "./dist/sounds.js" },
    "./browser": { "types": "./dist/browser.d.ts", "import": "./dist/browser.js" },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:paid-browser": "node scripts/run-tests.mjs --browser",
    "verify:standalone": "node scripts/verify-standalone.mjs",
    "review:local": "node scripts/serve-local-review.mjs"
  },
  "dependencies": {
    "@fortuneforge/client-presentation": "0.1.0",
    "@fortuneforge/slot-client-core": "0.1.0",
    "@fortuneforge/slot-game-runtime": "0.1.0"
  },
  "peerDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "~6.0.3",
    "vite": "^8.1.6",
    "vitest": "^4.1.12",
    "jsdom": "^28.1.0"
  }
}
