{
  "name": "@fortuneforge/games-crooked-road",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./sounds": {
      "types": "./dist/sounds.d.ts",
      "import": "./dist/sounds.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "local": "vite --config local/vite.config.ts",
    "check": "node scripts/copy-static.mjs --sync-contract && tsc -p tsconfig.json --noEmit",
    "build": "node scripts/copy-static.mjs --sync-contract && tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs && vitest run --exclude \"**/*.mjs\""
  },
  "dependencies": {
    "@fortuneforge/slot-client-core": "0.1.0",
    "@fortuneforge/client-presentation": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "~6.0.3",
    "vite": "^8.1.6",
    "vitest": "^4.1.12",
    "jsdom": "^28.1.0"
  }
}
