{
  "name": "@fortuneforge/games-hi-lo",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": ["dist", "README.md"],
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./styles.css": "./dist/index.css" },
  "scripts": {
    "dev": "concurrently -k -n api,ui \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:api": "dotnet run --project ../../samples/FortuneForge.Games.HiLo.Web/FortuneForge.Games.HiLo.Web.csproj",
    "dev:ui": "vite --host 127.0.0.1 --port 5183",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node src/HiLoGame.e2e.mjs",
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "peerDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "dependencies": { "@fontsource-variable/sora": "^5.2.8" },
  "devDependencies": { "@playwright/test": "^1.55.1", "@testing-library/dom": "^10.4.1", "@testing-library/react": "^16.3.2", "@testing-library/user-event": "^14.6.1", "@types/react": "^19.2.17", "@types/react-dom": "^19.2.3", "@vitejs/plugin-react": "^6.0.3", "concurrently": "^9.2.1", "jsdom": "^28.1.0", "react": "^19.2.7", "react-dom": "^19.2.7", "typescript": "~6.0.2", "vite": "^8.1.1", "vitest": "^4.1.10" }
}
