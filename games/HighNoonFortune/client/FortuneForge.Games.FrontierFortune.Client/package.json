{
  "name": "@fortuneforge/games-frontier-fortune",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": ["dist", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./manifest": { "types": "./dist/manifest.d.ts", "import": "./dist/manifest.js" },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "check": "node scripts/sync-rules.mjs && tsc --project tsconfig.json --noEmit",
    "build": "node scripts/prepare-build.mjs && tsc --project tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "peerDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "dependencies": { "@fortuneforge/slot-client-core": "0.1.0" },
  "devDependencies": { "@types/react": "^19.2.17", "@types/react-dom": "^19.2.3", "typescript": "~6.0.3", "vite": "^8.1.6" }
}
