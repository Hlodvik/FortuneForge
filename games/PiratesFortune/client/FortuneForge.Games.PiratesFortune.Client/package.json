{
  "name": "@fortuneforge/games-pirates-fortune",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./sounds": {
      "types": "./dist/sounds.d.ts",
      "import": "./dist/sounds.js"
    },
    "./PiratesSpinControls": {
      "types": "./dist/PiratesSpinControls.d.ts",
      "import": "./dist/PiratesSpinControls.js"
    },
    "./TreasureGemFlyover": {
      "types": "./dist/TreasureGemFlyover.d.ts",
      "import": "./dist/TreasureGemFlyover.js"
    },
    "./styles.css": "./dist/styles.css",
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "test": "vitest run --config vitest.config.ts",
    "verify:standalone": "node scripts/verify-standalone.mjs"
  },
  "dependencies": {
    "@fortuneforge/slot-client-core": "0.1.0",
    "@fortuneforge/slot-game-runtime": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "~6.0.3",
    "vite": "^8.1.6",
    "vitest": "^4.1.12",
    "jsdom": "^28.1.0",
    "@types/node": "24.13.3"
  }
}
