<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj/$(GamePackage)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(GamePackage)/</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Web" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SelectedGameDirectory>../../$(GamePackage)</SelectedGameDirectory>
    <SelectedEngineProject>$(SelectedGameDirectory)/src/FortuneForge.Games.$(GamePackage)/FortuneForge.Games.$(GamePackage).csproj</SelectedEngineProject>
    <SelectedComputeModule>$(SelectedGameDirectory)/server/GameComputeModule.cs</SelectedComputeModule>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GamePackage)' == 'FreeSolitaire'">
    <SelectedEngineProject>../../Solitaire/src/FortuneForge.Games.Solitaire/FortuneForge.Games.Solitaire.csproj</SelectedEngineProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;GameComputeEndpoints.cs" />
    <Compile Include="$(SelectedComputeModule)" Link="GameComputeModule.cs" Condition="Exists('$(SelectedComputeModule)')" />
    <ProjectReference Include="../FortuneForge.Games.Abstractions/FortuneForge.Games.Abstractions.csproj" />
    <ProjectReference Include="../FortuneForge.Games.Hosting/FortuneForge.Games.Hosting.csproj" />
    <ProjectReference Include="$(SelectedEngineProject)" Condition="Exists('$(SelectedEngineProject)')" />
  </ItemGroup>
  <ItemGroup Condition="'$(GamePackage)' == 'Solitaire' Or '$(GamePackage)' == 'FreeSolitaire'">
    <Compile Include="../../Solitaire/server/SolitaireComputeEndpoints.cs" Link="SolitaireComputeEndpoints.cs" />
  </ItemGroup>
  <Target Name="RequireSelectedComputeModule" BeforeTargets="Restore;PrepareForBuild">
    <Error Condition="'$(GamePackage)' == '' Or !Exists('$(SelectedEngineProject)') Or !Exists('$(SelectedComputeModule)')"
           Text="Supply a GamePackage with an engine project and compute module." />
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.Web" />
</Project>
