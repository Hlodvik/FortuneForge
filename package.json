{
  "name": "fortune-forge-workspace",
  "private": true,
  "workspaces": [
    "games/Asteroids/client/FortuneForge.Games.Asteroids.Client",
    "games/TwentyFortyEight/client/FortuneForge.Games.TwentyFortyEight.Client",
    "games/Baccarat/client/FortuneForge.Games.Baccarat.Client",
    "games/CasinoWar/client/FortuneForge.Games.CasinoWar.Client",
    "games/Craps/client/FortuneForge.Games.Craps.Client",
    "games/DropMerge/client/FortuneForge.Games.DropMerge.Client",
    "games/Flappy/client/FortuneForge.Games.Flappy.Client",
    "games/HorseFlight/client/FortuneForge.Games.HorseFlight.Client",
    "games/Snake/client/FortuneForge.Games.Snake.Client",
    "games/Hearts/client/FortuneForge.Games.Hearts.Client",
    "games/LiarsDice/client/FortuneForge.Games.LiarsDice.Client",
    "games/Roulette/client/FortuneForge.Games.Roulette.Client",
    "games/Keno/client/FortuneForge.Games.Keno.Client",
    "games/SicBo/client/FortuneForge.Games.SicBo.Client",
    "games/VideoPoker/client/FortuneForge.Games.VideoPoker.Client",
    "fortuneforge.client"
  ],
  "scripts": {
    "local:emulator": "firebase emulators:start --only firestore --project demo-fortuneforge-local",
    "local:api": "dotnet run --project ./FortuneForge.Server/FortuneForge.Server.csproj",
    "local:web": "npm run games:build && npm run dev --workspace fortuneforge.client",
    "games:check": "node ./scripts/run-game-workspaces.mjs check",
    "games:test": "node ./scripts/run-game-workspaces.mjs test",
    "games:build": "node ./scripts/run-game-workspaces.mjs build",
    "verify:game-source": "node ./scripts/verify-game-source-ownership.mjs",
    "verify:game-routes": "node ./scripts/verify-game-route-inventory.mjs",
    "web:test": "npm run test --workspace fortuneforge.client",
    "test:slots:visual": "npm run test:visual --workspace fortuneforge.client",
    "test:slots:visual:update": "npm run test:visual:update --workspace fortuneforge.client",
    "web:lint": "npm run lint --workspace fortuneforge.client",
    "web:build": "npm run build --workspace fortuneforge.client",
    "smoke:production": "node ./scripts/smoke-production.mjs",
    "test": "npm run games:test && npm run web:test",
    "lint": "npm run web:lint",
    "build": "npm run games:build && npm run web:build",
    "verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-release.ps1",
    "verify:slot-math": "dotnet run --project ./tools/FortuneForge.SlotMath/FortuneForge.SlotMath.csproj --configuration Release -- 250000",
    "analyze:slots": "dotnet run --project ./tools/FortuneForge.SlotMath/FortuneForge.SlotMath.csproj --configuration Release -- 250000",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy.ps1",
    "deploy:api": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy.ps1 -Target api",
    "deploy:hosting": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy.ps1 -Target hosting"
  }
}
