{
  "name": "@fortuneforge/slot-game-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./experience": {
      "types": "./dist/experience.d.ts",
      "import": "./dist/experience.js"
    },
    "./showcase": {
      "types": "./dist/showcase.d.ts",
      "import": "./dist/showcase.js"
    },
    "./symbols": {
      "types": "./dist/symbols.d.ts",
      "import": "./dist/symbols.js"
    },
    "./engine-guide": {
      "types": "./dist/engineGuide.d.ts",
      "import": "./dist/engineGuide.js"
    },
    "./contracts/engine-guide-contracts.json": "./dist/contracts/engine-guide-contracts.json"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs"
  },
  "dependencies": {
    "@fortuneforge/slot-client-core": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "typescript": "~6.0.3"
  }
}
